* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  color: #222;
  line-height: 1.5;
}

header {
  background-color: #1e2a3a;
  color: #fff;
  padding: 1rem;
}

header h1 {
  font-size: 1.4rem;
}

nav ul {
  list-style: none;
  display: flex;
  gap: 1rem;
  margin-top: 0.5rem;
}

nav a {
  color: #fff;
  text-decoration: none;
}

nav a:hover {
  text-decoration: underline;
}

main {
  padding: 1.5rem;
  max-width: 900px;
  margin: 0 auto;
}

h2 {
  margin-bottom: 0.6rem;
}

p {
  margin-bottom: 1rem;
}

table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1.5rem;
}

th, td {
  border: 1px solid #ccc;
  padding: 0.5rem;
  text-align: left;
}

th {
  background-color: #eee;
}

form {
  display: flex;
  flex-direction: column;
  gap: 0.8rem;
  max-width: 400px;
}

label {
  font-weight: bold;
}

input, select, textarea {
  padding: 0.4rem;
}

button {
  padding: 0.6rem;
  background-color: #1e2a3a;
  color: #fff;
  border: none;
  cursor: pointer;
}

footer {
  background-color: #1e2a3a;
  color: #fff;
  text-align: center;
  padding: 1rem;
  margin-top: 2rem;
}
